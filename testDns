Import-Module DnsServer -ErrorAction Stop

$dnsServer = 'crcordc01.bacnet.corp.redbac.com'
$zoneName = 'bacnet.corp.redbac.com'

$testRecords = @(
    @{ Name = 'test-aria-01'; IP = '10.136.18.230' }
    @{ Name = 'test-aria-02'; IP = '10.136.18.231' }
)

foreach ($record in $testRecords) {
    Remove-DnsServerResourceRecord `
        -ComputerName $dnsServer `
        -ZoneName $zoneName `
        -Name $record.Name `
        -RRType A `
        -RecordData $record.IP `
        -Force `
        -ErrorAction Stop

    Write-Host "Eliminado: $($record.Name) -> $($record.IP)"
}
