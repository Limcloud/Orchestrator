var category = Server.getConfigurationElementCategoryWithPath("web-root");

if (!category) {
    throw "No se encontró la carpeta de configuraciones web-root.";
}

var config = null;
var elements = category.configurationElements;

for (var i = 0; i < elements.length; i++) {
    if (elements[i].name === "GTC-VMs-NOMBRES") {
        config = elements[i];
        break;
    }
}

if (!config) {
    throw "No se encontró GTC-VMs-NOMBRES en la carpeta web-root.";
}

var attribute = config.getAttributeWithKey("listado");

if (!attribute || !attribute.value) {
    throw "El atributo listado no existe o está vacío.";
}

var entries;

try {
    entries = JSON.parse(attribute.value);
} catch (e) {
    throw "El atributo listado no contiene JSON válido: " + e;
}

if (!Array.isArray(entries)) {
    throw "El atributo listado debe contener un arreglo entre [ ].";
}

var availableNames = [];

for (var j = 0; j < entries.length; j++) {
    var entry = entries[j];

    if (!entry ||
        typeof entry.name !== "string" ||
        entry.name.trim() === "" ||
        typeof entry.inUse !== "boolean") {
        throw "Registro inválido en la posición " + j +
              ". Se requieren name (texto) e inUse (booleano).";
    }

    if (entry.inUse === false) {
        availableNames.push(entry.name);
    }
}

return availableNames;
