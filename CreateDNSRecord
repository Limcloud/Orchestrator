function Handler($context, $inputs) {
    $ErrorActionPreference = 'Stop'
    $connection = $null
    $stage = 'Validar configuración'

    try {
        # No imprimir: contiene credenciales.
        $settings = @{
            vCenter         = $inputs.vCenter
            vCenterUsername = $inputs.vCenterUsername
            vCenterPassword = $inputs.vCenterPassword
            executionVmName = $inputs.executionVmName
            guestUsername   = $inputs.guestUsername
            guestPassword   = $inputs.guestPassword
            dnsServer       = $inputs.dnsServer
            zoneName        = $inputs.zoneName
            recordName      = $inputs.recordName
            ipAddress       = $inputs.ipAddress
        }

        foreach ($name in $settings.Keys) {
            if ([string]::IsNullOrWhiteSpace([string]$settings[$name])) {
                throw "El input '$name' llegó vacío. Revisa su vínculo."
            }
        }

        $parametersJson = @{
            dnsServer  = ([string]$settings.dnsServer).Trim()
            zoneName   = ([string]$settings.zoneName).Trim().TrimEnd('.')
            recordName = ([string]$settings.recordName).Trim().ToLowerInvariant()
            ipAddress  = ([string]$settings.ipAddress).Trim()
        } | ConvertTo-Json -Compress

        $parametersBase64 = [Convert]::ToBase64String(
            [Text.Encoding]::UTF8.GetBytes($parametersJson)
        )

        # Código que se ejecutará dentro de Windows.
        $guestScript = @'
$ErrorActionPreference = 'Stop'
$stage = 'Validar parámetros'
$created = $false
$exitCode = 0

try {
    $json = [Text.Encoding]::UTF8.GetString(
        [Convert]::FromBase64String('__DNS_PARAMETERS__')
    )
    $p = $json | ConvertFrom-Json

    $dnsServer = [string]$p.dnsServer
    $zoneName = [string]$p.zoneName
    $recordName = [string]$p.recordName
    $ipAddress = [string]$p.ipAddress
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent().Name

    if ($recordName -notmatch '^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$') {
        throw 'recordName debe ser un hostname de 1 a 63 caracteres, sin dominio y con guiones solo en el interior.'
    }

    if ([string]::IsNullOrWhiteSpace($dnsServer)) {
        throw 'dnsServer está vacío.'
    }

    if ([string]::IsNullOrWhiteSpace($zoneName)) {
        throw 'zoneName está vacío.'
    }

    if ($ipAddress -notmatch '^(?:0|[1-9]\d{0,2})(?:\.(?:0|[1-9]\d{0,2})){3}$') {
        throw 'ipAddress debe ser una IPv4 con cuatro octetos decimales.'
    }

    foreach ($octet in $ipAddress.Split('.')) {
        if ([int]$octet -gt 255) {
            throw 'ipAddress contiene un octeto mayor que 255.'
        }
    }

    $fqdn = "$recordName.$zoneName"

    $stage = 'Cargar módulo DnsServer'
    Import-Module DnsServer -ErrorAction Stop

    $stage = 'Consultar zona DNS'
    $zone = Get-DnsServerZone -ComputerName $dnsServer -Name $zoneName -ErrorAction Stop

    if ($null -eq $zone) {
        throw "La zona '$zoneName' no fue encontrada."
    }

    if ($zone.IsReverseLookupZone) {
        throw "La zona '$zoneName' es reversa."
    }

    $stage = 'Comprobar registros existentes'

    # No ocultar errores de acceso o conectividad.
    $records = @(
        Get-DnsServerResourceRecord -ComputerName $dnsServer -ZoneName $zoneName -ErrorAction Stop |
            Where-Object { $_.HostName -eq $recordName }
    )

    $cnames = @($records | Where-Object { $_.RecordType -eq 'CNAME' })
    if ($cnames.Count -gt 0) {
        throw "Conflicto: '$fqdn' ya tiene un CNAME."
    }

    $existingIps = @(
        $records |
            Where-Object { $_.RecordType -eq 'A' } |
            ForEach-Object { $_.RecordData.IPv4Address.ToString() }
    )

    $differentIps = @($existingIps | Where-Object { $_ -ne $ipAddress })
    if ($differentIps.Count -gt 0) {
        throw "Conflicto: '$fqdn' tiene otra IP: $($existingIps -join ', ')."
    }

    if ($existingIps -contains $ipAddress) {
        $status = 'alreadyExists'
    }
    else {
        $stage = 'Crear registro A'

        Add-DnsServerResourceRecordA -ComputerName $dnsServer -ZoneName $zoneName -Name $recordName -IPv4Address $ipAddress -ErrorAction Stop

        $created = $true
        $status = 'created'
    }

    $stage = 'Verificar registro A'

    $verifiedIps = @(
        Get-DnsServerResourceRecord -ComputerName $dnsServer -ZoneName $zoneName -Name $recordName -RRType A -ErrorAction Stop |
            ForEach-Object { $_.RecordData.IPv4Address.ToString() }
    )

    $unexpectedIps = @($verifiedIps | Where-Object { $_ -ne $ipAddress })

    if (($verifiedIps -notcontains $ipAddress) -or ($unexpectedIps.Count -gt 0)) {
        throw "La verificación no coincide con la IP solicitada. IPs: $($verifiedIps -join ', ')."
    }

    $response = [ordered]@{
        success      = $true
        status       = $status
        computerName = $env:COMPUTERNAME
        executedAs   = $identity
        dnsServer    = $dnsServer
        zoneName     = $zoneName
        fqdn         = $fqdn
        ipAddress    = $ipAddress
        created      = $created
        ptrCreated   = $false
    }
}
catch {
    $failure = $_
    $exitCode = 1

    $response = [ordered]@{
        success               = $false
        computerName          = $env:COMPUTERNAME
        stage                 = $stage
        created               = $created
        error                 = $failure.Exception.Message
        fullyQualifiedErrorId = $failure.FullyQualifiedErrorId
        scriptLineNumber      = $failure.InvocationInfo.ScriptLineNumber
    }
}

# Emitir el JSON antes de terminar el proceso.
$responseJson = $response | ConvertTo-Json -Compress
[Console]::Out.WriteLine($responseJson)
[Console]::Out.Flush()
exit $exitCode
'@

        $guestScript = $guestScript.Replace(
            '__DNS_PARAMETERS__',
            $parametersBase64
        )

        $stage = 'Validar sintaxis del script remoto'
        Write-Host "Etapa: $stage"

        $tokens = $null
        $parseErrors = $null

        $null = [System.Management.Automation.Language.Parser]::ParseInput(
            $guestScript,
            [ref]$tokens,
            [ref]$parseErrors
        )

        if ($parseErrors.Count -gt 0) {
            $details = (
                $parseErrors | ForEach-Object {
                    "Línea $($_.Extent.StartLineNumber): $($_.Message)"
                }
            ) -join '; '

            throw "Errores de sintaxis en el script remoto: $details"
        }

        $stage = 'Comprimir script remoto'

        $scriptBytes = [Text.Encoding]::UTF8.GetBytes($guestScript)
        $memoryStream = [IO.MemoryStream]::new()

        try {
            $gzipStream = [IO.Compression.GZipStream]::new(
                $memoryStream,
                [IO.Compression.CompressionMode]::Compress,
                $true
            )

            try {
                $gzipStream.Write($scriptBytes, 0, $scriptBytes.Length)
            }
            finally {
                $gzipStream.Dispose()
            }

            $compressedScript = [Convert]::ToBase64String(
                $memoryStream.ToArray()
            )
        }
        finally {
            $memoryStream.Dispose()
        }

        # Lanzador corto: descomprime y ejecuta en memoria.
        $bootstrap = @'
$ErrorActionPreference = 'Stop'
try {
    $m = New-Object IO.MemoryStream
    $b = [Convert]::FromBase64String('__PAYLOAD__')
    $m.Write($b, 0, $b.Length)
    $m.Position = 0
    $g = New-Object IO.Compression.GZipStream($m, [IO.Compression.CompressionMode]::Decompress)
    $r = New-Object IO.StreamReader($g, [Text.Encoding]::UTF8)
    try { $s = $r.ReadToEnd() }
    finally { $r.Dispose(); $m.Dispose() }
    & ([scriptblock]::Create($s))
}
catch {
    $j = @{success=$false; stage='Descomprimir o iniciar script'; error=$_.Exception.Message} | ConvertTo-Json -Compress
    [Console]::Out.WriteLine($j)
    [Console]::Out.Flush()
    exit 1
}
'@

        $bootstrap = $bootstrap.Replace('__PAYLOAD__', $compressedScript)

        Write-Host "Longitud original: $($guestScript.Length)"
        Write-Host "Longitud enviada: $($bootstrap.Length)"

        Set-PowerCLIConfiguration `
            -InvalidCertificateAction Ignore `
            -Scope Session `
            -Confirm:$false | Out-Null

        $stage = 'Conectar a vCenter'
        Write-Host "Etapa: $stage"

        $connection = Connect-VIServer `
            -Server $settings.vCenter `
            -User $settings.vCenterUsername `
            -Password $settings.vCenterPassword `
            -NotDefault `
            -ErrorAction Stop

        $stage = 'Localizar VM'
        Write-Host "Etapa: $stage"

        $vmName = [string]$settings.executionVmName

        $vms = @(
            Get-VM -Server $connection -Name $vmName -ErrorAction Stop |
                Where-Object { $_.Name -eq $vmName }
        )

        if ($vms.Count -ne 1) {
            throw "Se esperaba una única VM llamada '$vmName'; encontradas: $($vms.Count)."
        }

        $vm = $vms[0]

        if ($vm.PowerState -ne 'PoweredOn') {
            throw "La VM '$vmName' no está encendida."
        }

        $stage = 'Ejecutar operación DNS mediante VMware Tools'
        Write-Host "Etapa: $stage"

        $result = Invoke-VMScript `
            -Server $connection `
            -VM $vm `
            -ScriptType PowerShell `
            -ScriptText $bootstrap `
            -GuestUser $settings.guestUsername `
            -GuestPassword $settings.guestPassword `
            -ToolsWaitSecs 60 `
            -ErrorAction Stop

        $stage = 'Validar resultado'
        Write-Host "Etapa: $stage"

        $scriptOutput = ([string]$result.ScriptOutput).Trim()

        Write-Host "Código de salida remoto: $($result.ExitCode)"
        Write-Host "Caracteres recibidos: $($scriptOutput.Length)"

        if (-not [string]::IsNullOrWhiteSpace($scriptOutput)) {
            Write-Host "Resultado remoto: $scriptOutput"
        }
        else {
            throw "El proceso remoto terminó con código $($result.ExitCode) sin salida. No se puede determinar si creó el registro."
        }

        if ($result.ExitCode -ne 0) {
            throw "El script remoto terminó con código $($result.ExitCode). $scriptOutput"
        }

        $parsedResult = $scriptOutput |
            ConvertFrom-Json -ErrorAction Stop

        if ($parsedResult.success -ne $true) {
            throw "La operación DNS no reportó éxito. $scriptOutput"
        }

        Write-Host 'Operación DNS completada correctamente.'
        Write-Host "Equipo: $($parsedResult.computerName)"
        Write-Host "Ejecutado como: $($parsedResult.executedAs)"
        Write-Host "Estado: $($parsedResult.status)"
        Write-Host "Registro: $($parsedResult.fqdn)"
        Write-Host "IP: $($parsedResult.ipAddress)"

        return $scriptOutput
    }
    catch {
        throw "Falló la etapa '$stage': $($_.Exception.Message)"
    }
    finally {
        if ($null -ne $connection) {
            try {
                Disconnect-VIServer `
                    -Server $connection `
                    -Confirm:$false `
                    -ErrorAction Stop | Out-Null
            }
            catch {
                Write-Warning 'No fue posible cerrar la conexión a vCenter.'
            }
        }
    }
}
