function Handler($context, $inputs) {
    $ErrorActionPreference = 'Stop'
    $connection = $null

    try {
        foreach ($name in @(
            'vCenter', 'vCenterUsername', 'vCenterPassword',
            'executionVmName', 'guestUsername', 'guestPassword',
            'dnsServer', 'zoneName', 'recordName', 'ipAddress'
        )) {
            $value = $inputs.$name
            if ([string]::IsNullOrWhiteSpace([string]$value)) {
                throw "Falta el input '$name'."
            }
        }

        $name = ([string]$inputs.recordName).Trim().ToLowerInvariant()
        $ip = ([string]$inputs.ipAddress).Trim()
        $zone = ([string]$inputs.zoneName).Trim().TrimEnd('.').ToLowerInvariant()

        if ($name -notmatch '^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$') {
            throw 'recordName debe ser un hostname válido de hasta 63 caracteres, sin dominio.'
        }

        if ($ip -notmatch '^(?:0|[1-9]\d{0,2})(?:\.(?:0|[1-9]\d{0,2})){3}$') {
            throw 'ipAddress debe ser una IPv4 válida.'
        }

        foreach ($octet in $ip.Split('.')) {
            if ([int]$octet -gt 255) {
                throw 'ipAddress contiene un octeto mayor que 255.'
            }
        }

        $data = @{
            server = ([string]$inputs.dnsServer).Trim()
            zone   = $zone
            name   = $name
            ip     = $ip
        } | ConvertTo-Json -Compress

        $data = [Convert]::ToBase64String(
            [Text.Encoding]::UTF8.GetBytes($data)
        )

        $script = @'
$ErrorActionPreference = 'Stop'
$aCreated = $false
$ptrCreated = $false
$code = 0
try {
    $p = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__DATA__')) | ConvertFrom-Json
    Import-Module DnsServer -ErrorAction Stop

    $o = $p.ip.Split('.')
    $rz = "$($o[2]).$($o[1]).$($o[0]).in-addr.arpa"
    $rn = $o[3]
    $fqdn = "$($p.name).$($p.zone)"

    $zones = @(Get-DnsServerZone -ComputerName $p.server -ErrorAction Stop)
    if (-not ($zones | Where-Object { $_.ZoneName -eq $p.zone -and -not $_.IsReverseLookupZone })) {
        throw "No se encontró la zona directa '$($p.zone)'. No se crearon registros."
    }
    if (-not ($zones | Where-Object { $_.ZoneName -eq $rz -and $_.IsReverseLookupZone })) {
        throw "No se encontró la zona reversa '$rz'. No se crearon registros."
    }

    $forward = @(Get-DnsServerResourceRecord -ComputerName $p.server -ZoneName $p.zone -ErrorAction Stop | Where-Object { $_.HostName -eq $p.name })
    $reverse = @(Get-DnsServerResourceRecord -ComputerName $p.server -ZoneName $rz -ErrorAction Stop | Where-Object { $_.HostName -eq $rn })

    if (@($forward + $reverse | Where-Object { $_.RecordType -eq 'CNAME' }).Count) {
        throw 'Conflicto: existe un CNAME en el nombre directo o reverso.'
    }

    $ips = @($forward | Where-Object { $_.RecordType -eq 'A' } | ForEach-Object { $_.RecordData.IPv4Address.ToString() })
    $targets = @($reverse | Where-Object { $_.RecordType -eq 'PTR' } | ForEach-Object { $_.RecordData.PtrDomainName.TrimEnd('.').ToLowerInvariant() })

    if (@($ips | Where-Object { $_ -ne $p.ip }).Count) {
        throw "Conflicto A: '$fqdn' tiene otra IP: $($ips -join ', ')."
    }
    if (@($targets | Where-Object { $_ -ne $fqdn }).Count) {
        throw "Conflicto PTR: '$($p.ip)' apunta a otro nombre: $($targets -join ', ')."
    }

    if ($ips -notcontains $p.ip) {
        Add-DnsServerResourceRecordA -ComputerName $p.server -ZoneName $p.zone -Name $p.name -IPv4Address $p.ip -ErrorAction Stop
        $aCreated = $true
    }
    if ($targets -notcontains $fqdn) {
        Add-DnsServerResourceRecordPtr -ComputerName $p.server -ZoneName $rz -Name $rn -PtrDomainName "$fqdn." -ErrorAction Stop
        $ptrCreated = $true
    }

    $ips = @(Get-DnsServerResourceRecord -ComputerName $p.server -ZoneName $p.zone -Name $p.name -RRType A -ErrorAction Stop | ForEach-Object { $_.RecordData.IPv4Address.ToString() })
    $targets = @(Get-DnsServerResourceRecord -ComputerName $p.server -ZoneName $rz -Name $rn -RRType PTR -ErrorAction Stop | ForEach-Object { $_.RecordData.PtrDomainName.TrimEnd('.').ToLowerInvariant() })

    if (($ips -notcontains $p.ip) -or ($targets -notcontains $fqdn) -or
        @($ips | Where-Object { $_ -ne $p.ip }).Count -or
        @($targets | Where-Object { $_ -ne $fqdn }).Count) {
        throw 'La verificación final de A/PTR no coincide.'
    }

    $status = 'alreadyExists'
    if ($aCreated -or $ptrCreated) { $status = 'created' }
    $result = @{success=$true; status=$status; fqdn=$fqdn; ipAddress=$p.ip; reverseZone=$rz; aCreated=$aCreated; ptrCreated=$ptrCreated}
}
catch {
    $code = 1
    $result = @{success=$false; error=$_.Exception.Message; aCreated=$aCreated; ptrCreated=$ptrCreated}
}
[Console]::Out.WriteLine(($result | ConvertTo-Json -Compress))
[Console]::Out.Flush()
exit $code
'@

        $script = $script.Replace('__DATA__', $data)

        # Reducir el texto enviado por Invoke-VMScript.
        $stream = [IO.MemoryStream]::new()
        try {
            $gzip = [IO.Compression.GZipStream]::new(
                $stream,
                [IO.Compression.CompressionMode]::Compress,
                $true
            )
            try {
                $bytes = [Text.Encoding]::UTF8.GetBytes($script)
                $gzip.Write($bytes, 0, $bytes.Length)
            }
            finally {
                $gzip.Dispose()
            }

            $payload = [Convert]::ToBase64String($stream.ToArray())
        }
        finally {
            $stream.Dispose()
        }

        $launcher = @'
$m = New-Object IO.MemoryStream
$b = [Convert]::FromBase64String('__PAYLOAD__')
$m.Write($b,0,$b.Length)
$m.Position = 0
$g = New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress)
$r = New-Object IO.StreamReader($g,[Text.Encoding]::UTF8)
try { $s = $r.ReadToEnd() } finally { $r.Dispose(); $m.Dispose() }
& ([scriptblock]::Create($s))
'@
        $launcher = $launcher.Replace('__PAYLOAD__', $payload)

        Set-PowerCLIConfiguration `
            -InvalidCertificateAction Ignore `
            -Scope Session `
            -Confirm:$false | Out-Null

        $connection = Connect-VIServer `
            -Server $inputs.vCenter `
            -User $inputs.vCenterUsername `
            -Password $inputs.vCenterPassword `
            -NotDefault `
            -ErrorAction Stop

        $vms = @(
            Get-VM -Server $connection -Name $inputs.executionVmName -ErrorAction Stop |
                Where-Object { $_.Name -eq $inputs.executionVmName }
        )

        if ($vms.Count -ne 1) {
            throw "Se esperaba una única VM; encontradas: $($vms.Count)."
        }

        Write-Host "Ejecutando en: $($vms[0].Name)"
        Write-Host "Longitud enviada: $($launcher.Length)"

        $execution = Invoke-VMScript `
            -Server $connection `
            -VM $vms[0] `
            -ScriptType PowerShell `
            -ScriptText $launcher `
            -GuestUser $inputs.guestUsername `
            -GuestPassword $inputs.guestPassword `
            -ToolsWaitSecs 60 `
            -ErrorAction Stop

        $output = ([string]$execution.ScriptOutput).Trim()

        if ([string]::IsNullOrWhiteSpace($output)) {
            throw "Código remoto $($execution.ExitCode), sin salida. Verifica el estado de los registros en DNS."
        }

        Write-Host $output
        $result = $output | ConvertFrom-Json -ErrorAction Stop

        if ($execution.ExitCode -ne 0 -or $result.success -ne $true) {
            throw "Falló la operación DNS: $output"
        }

        return $output
    }
    finally {
        if ($null -ne $connection) {
            try {
                Disconnect-VIServer -Server $connection -Confirm:$false -ErrorAction Stop | Out-Null
            }
            catch {
                Write-Warning 'No fue posible cerrar la conexión a vCenter.'
            }
        }
    }
}
