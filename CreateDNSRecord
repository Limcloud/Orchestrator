function Handler($context, $inputs) {
    $ErrorActionPreference = 'Stop'
    $connection = $null
    $stage = 'Validar configuración'

    try {
        # Leer los inputs sin imprimir credenciales.
        $settings = @{
            vCenter         = $inputs.vCenter
            vCenterUsername = $inputs.vCenterUsername
            vCenterPassword = $inputs.vCenterPassword
            executionVmName = $inputs.executionVmName
            guestUsername   = $inputs.guestUsername
            guestPassword   = $inputs.guestPassword
        }

        foreach ($name in $settings.Keys) {
            if ([string]::IsNullOrWhiteSpace([string]$settings[$name])) {
                throw "El input '$name' llegó vacío a la acción. Revisa su vínculo."
            }
        }
  
        Set-PowerCLIConfiguration `
        -InvalidCertificateAction Ignore `
        -Scope Session `
        -Confirm:$false | Out-Null

        # Conectar únicamente al vCenter configurado.
        $stage = 'Conectar a vCenter'
        Write-Host "Etapa: $stage"

        $connection = Connect-VIServer `
            -Server $settings.vCenter `
            -User $settings.vCenterUsername `
            -Password $settings.vCenterPassword `
            -NotDefault `
            -ErrorAction Stop

        # Localizar una única VM con el nombre exacto.
        $stage = 'Localizar VM'
        Write-Host "Etapa: $stage"

        $vmName = [string]$settings.executionVmName

        $vms = @(
            Get-VM `
                -Server $connection `
                -Name $vmName `
                -ErrorAction Stop |
                Where-Object { $_.Name -eq $vmName }
        )

        if ($vms.Count -ne 1) {
            throw "Se esperaba una única VM llamada '$vmName'; encontradas: $($vms.Count)."
        }

        $vm = $vms[0]

        if ($vm.PowerState -ne 'PoweredOn') {
            throw "La VM '$vmName' no está encendida."
        }

        # Este script se ejecutará dentro de Windows mediante VMware Tools.
        # No realiza consultas ni modificaciones en DNS.
        $guestScript = @'
$ErrorActionPreference = 'Stop'
$testFile = $null

try {
    $computerName = $env:COMPUTERNAME
    $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name

    $testFile = Join-Path -Path $env:TEMP -ChildPath (
        'vro-execution-test-' + [guid]::NewGuid().ToString() + '.txt'
    )

    $expectedContent = 'Prueba de ejecucion remota desde Orchestrator'

    # Crear el archivo de prueba.
    Set-Content `
        -LiteralPath $testFile `
        -Value $expectedContent `
        -Encoding UTF8 `
        -ErrorAction Stop

    # Leer y comprobar el contenido.
    $actualContent = Get-Content `
        -LiteralPath $testFile `
        -Raw `
        -ErrorAction Stop

    if ($actualContent.TrimEnd() -ne $expectedContent) {
        throw 'El contenido leído no coincide con el contenido escrito.'
    }

    # Eliminar únicamente el archivo generado por esta ejecución.
    Remove-Item `
        -LiteralPath $testFile `
        -Force `
        -ErrorAction Stop

    if (Test-Path -LiteralPath $testFile) {
        throw 'No fue posible eliminar el archivo de prueba.'
    }

    [ordered]@{
        success      = $true
        computerName = $computerName
        executedAs   = $identity
        filePath     = $testFile
        fileCreated  = $true
        fileRead     = $true
        fileDeleted  = $true
    } | ConvertTo-Json -Compress

    exit 0
}
catch {
    $failureMessage = $_.Exception.Message

    # Intentar limpiar el archivo si la prueba falló.
    if ($testFile) {
        Remove-Item `
            -LiteralPath $testFile `
            -Force `
            -ErrorAction SilentlyContinue
    }

    [ordered]@{
        success      = $false
        computerName = $env:COMPUTERNAME
        error        = $failureMessage
    } | ConvertTo-Json -Compress

    exit 1
}
'@

        $stage = 'Ejecutar PowerShell mediante VMware Tools'
        Write-Host "Etapa: $stage"

        $result = Invoke-VMScript `
            -Server $connection `
            -VM $vm `
            -ScriptType PowerShell `
            -ScriptText $guestScript `
            -GuestUser $settings.guestUsername `
            -GuestPassword $settings.guestPassword `
            -ToolsWaitSecs 60 `
            -ErrorAction Stop

        # Comprobar el resultado del proceso dentro de Windows.
        $stage = 'Validar resultado'
        Write-Host "Etapa: $stage"

        $scriptOutput = ([string]$result.ScriptOutput).Trim()

        if ($result.ExitCode -ne 0) {
            throw "El script remoto terminó con código $($result.ExitCode). $scriptOutput"
        }

        if ([string]::IsNullOrWhiteSpace($scriptOutput)) {
            throw 'El script remoto no devolvió ningún resultado.'
        }

        $parsedResult = $scriptOutput |
            ConvertFrom-Json -ErrorAction Stop

        if ($parsedResult.success -ne $true) {
            throw "La prueba remota no reportó éxito. $scriptOutput"
        }

        Write-Host "Prueba completada correctamente."
        Write-Host "Equipo: $($parsedResult.computerName)"
        Write-Host "Ejecutado como: $($parsedResult.executedAs)"
        Write-Host "Archivo creado, leído y eliminado correctamente."

        # La acción tiene Return type: string.
        return $scriptOutput
    }
    catch {
        throw "Falló la etapa '$stage': $($_.Exception.Message)"
    }
    finally {
        # Cerrar solamente la conexión abierta por esta acción.
        if ($null -ne $connection) {
            try {
                Disconnect-VIServer `
                    -Server $connection `
                    -Confirm:$false `
                    -ErrorAction Stop |
                    Out-Null
            }
            catch {
                Write-Warning 'No fue posible cerrar la conexión a vCenter.'
            }
        }
    }
}
