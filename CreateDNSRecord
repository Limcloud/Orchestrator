function Handler($context, $inputs) {
    $ErrorActionPreference = 'Stop'
    $connection = $null
    $stage = 'Validar configuración'

    try {
        # Credenciales y configuración recibidas del workflow.
        # Nunca imprimir este objeto en los logs.
        $settings = @{
            vCenter         = $inputs.vCenter
            vCenterUsername = $inputs.vCenterUsername
            vCenterPassword = $inputs.vCenterPassword
            executionVmName = $inputs.executionVmName
            guestUsername   = $inputs.guestUsername
            guestPassword   = $inputs.guestPassword
            dnsServer       = $inputs.dnsServer
            zoneName        = $inputs.zoneName
            recordName      = $inputs.recordName
            ipAddress       = $inputs.ipAddress
        }

        foreach ($name in $settings.Keys) {
            if ([string]::IsNullOrWhiteSpace([string]$settings[$name])) {
                throw "El input '$name' llegó vacío. Revisa su vínculo."
            }
        }

        Set-PowerCLIConfiguration `
            -InvalidCertificateAction Ignore `
            -Scope Session `
            -Confirm:$false | Out-Null

        $stage = 'Conectar a vCenter'
        Write-Host "Etapa: $stage"

        $connection = Connect-VIServer `
            -Server $settings.vCenter `
            -User $settings.vCenterUsername `
            -Password $settings.vCenterPassword `
            -NotDefault `
            -ErrorAction Stop

        $stage = 'Localizar VM'
        Write-Host "Etapa: $stage"

        $vmName = [string]$settings.executionVmName

        $vms = @(
            Get-VM `
                -Server $connection `
                -Name $vmName `
                -ErrorAction Stop |
                Where-Object { $_.Name -eq $vmName }
        )

        if ($vms.Count -ne 1) {
            throw "Se esperaba una única VM llamada '$vmName'; encontradas: $($vms.Count)."
        }

        $vm = $vms[0]

        if ($vm.PowerState -ne 'PoweredOn') {
            throw "La VM '$vmName' no está encendida."
        }

        # Enviar solamente los parámetros DNS al script remoto.
        # Base64 conserva el contenido JSON sin insertarlo como código.
        $dnsParameters = @{
            dnsServer  = ([string]$settings.dnsServer).Trim()
            zoneName   = ([string]$settings.zoneName).Trim().TrimEnd('.')
            recordName = ([string]$settings.recordName).Trim().ToLowerInvariant()
            ipAddress  = ([string]$settings.ipAddress).Trim()
        } | ConvertTo-Json -Compress

        $dnsParametersBase64 = [Convert]::ToBase64String(
            [Text.Encoding]::UTF8.GetBytes($dnsParameters)
        )

        # Este bloque se ejecuta dentro de Windows mediante VMware Tools.
        $guestScript = @'
$ErrorActionPreference = 'Stop'
$stage = 'Validar parámetros'
$created = $false

try {
    $parametersJson = [Text.Encoding]::UTF8.GetString(
        [Convert]::FromBase64String('__DNS_PARAMETERS__')
    )

    $parameters = $parametersJson | ConvertFrom-Json

    $dnsServer = [string]$parameters.dnsServer
    $zoneName = [string]$parameters.zoneName
    $recordName = [string]$parameters.recordName
    $ipAddress = [string]$parameters.ipAddress

    $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name

    # Solo aceptar hostname simple, sin dominio.
    if ($recordName -notmatch '^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$') {
        throw 'recordName debe tener entre 1 y 63 caracteres: letras, números y guiones internos, sin dominio.'
    }

    if ([string]::IsNullOrWhiteSpace($dnsServer)) {
        throw 'dnsServer está vacío.'
    }

    if ([string]::IsNullOrWhiteSpace($zoneName)) {
        throw 'zoneName está vacío.'
    }

    # Exigir una IPv4 con cuatro octetos decimales.
    if ($ipAddress -notmatch '^(?:0|[1-9]\d{0,2})(?:\.(?:0|[1-9]\d{0,2})){3}$') {
        throw 'ipAddress debe ser una IPv4 con cuatro octetos decimales.'
    }

    foreach ($octet in $ipAddress.Split('.')) {
        if ([int]$octet -gt 255) {
            throw 'ipAddress contiene un octeto mayor que 255.'
        }
    }

    $fqdn = "$recordName.$zoneName"

    $stage = 'Cargar módulo DnsServer'

    if (-not (Get-Module -ListAvailable -Name DnsServer)) {
        throw 'El módulo DnsServer no está instalado en la VM de ejecución.'
    }

    Import-Module DnsServer -ErrorAction Stop

    $stage = 'Consultar zona DNS'

    $zone = Get-DnsServerZone `
        -ComputerName $dnsServer `
        -Name $zoneName `
        -ErrorAction Stop

    if ($null -eq $zone) {
        throw "La zona '$zoneName' no fue encontrada."
    }

    if ($zone.IsReverseLookupZone) {
        throw "La zona '$zoneName' es reversa; se requiere una zona directa."
    }

    $stage = 'Comprobar registros existentes'

    # Consulta la zona y filtra el nombre exacto.
    # Los errores de acceso o conectividad deben detener la operación.
    $records = @(
        Get-DnsServerResourceRecord `
            -ComputerName $dnsServer `
            -ZoneName $zoneName `
            -ErrorAction Stop |
            Where-Object { $_.HostName -eq $recordName }
    )

    $cnameRecords = @(
        $records | Where-Object { $_.RecordType -eq 'CNAME' }
    )

    if ($cnameRecords.Count -gt 0) {
        throw "Conflicto: '$fqdn' ya tiene un registro CNAME."
    }

    $aRecords = @(
        $records | Where-Object { $_.RecordType -eq 'A' }
    )

    $existingIps = @(
        $aRecords |
            ForEach-Object { $_.RecordData.IPv4Address.ToString() }
    )

    $differentIps = @(
        $existingIps | Where-Object { $_ -ne $ipAddress }
    )

    if ($differentIps.Count -gt 0) {
        throw "Conflicto: '$fqdn' ya tiene otra IP: $($existingIps -join ', ')."
    }

    if ($existingIps -contains $ipAddress) {
        # El registro ya coincide: no modificarlo.
        $status = 'alreadyExists'
    }
    else {
        $stage = 'Crear registro A'

        Add-DnsServerResourceRecordA `
            -ComputerName $dnsServer `
            -ZoneName $zoneName `
            -Name $recordName `
            -IPv4Address $ipAddress `
            -ErrorAction Stop

        $created = $true
        $status = 'created'
    }

    $stage = 'Verificar registro A'

    $verifiedRecords = @(
        Get-DnsServerResourceRecord `
            -ComputerName $dnsServer `
            -ZoneName $zoneName `
            -Name $recordName `
            -RRType A `
            -ErrorAction Stop
    )

    $verifiedIps = @(
        $verifiedRecords |
            ForEach-Object { $_.RecordData.IPv4Address.ToString() }
    )

    $unexpectedIps = @(
        $verifiedIps | Where-Object { $_ -ne $ipAddress }
    )

    if (
        ($verifiedIps -notcontains $ipAddress) -or
        ($unexpectedIps.Count -gt 0)
    ) {
        throw "La verificación no coincide con la IP solicitada. IPs encontradas: $($verifiedIps -join ', ')."
    }

    [ordered]@{
        success      = $true
        status       = $status
        computerName = $env:COMPUTERNAME
        executedAs   = $identity
        dnsServer    = $dnsServer
        zoneName     = $zoneName
        fqdn         = $fqdn
        ipAddress    = $ipAddress
        created      = $created
        ptrCreated   = $false
    } | ConvertTo-Json -Compress

    exit 0
}
catch {
    # Si la creación terminó y falló la verificación,
    # created será true. No eliminar automáticamente el registro.
    [ordered]@{
        success      = $false
        computerName = $env:COMPUTERNAME
        stage        = $stage
        created      = $created
        error        = $_.Exception.Message
    } | ConvertTo-Json -Compress

    exit 1
}
'@

        $guestScript = $guestScript.Replace(
            '__DNS_PARAMETERS__',
            $dnsParametersBase64
        )

        $stage = 'Ejecutar operación DNS mediante VMware Tools'
        Write-Host "Etapa: $stage"

        $result = Invoke-VMScript `
            -Server $connection `
            -VM $vm `
            -ScriptType PowerShell `
            -ScriptText $guestScript `
            -GuestUser $settings.guestUsername `
            -GuestPassword $settings.guestPassword `
            -ToolsWaitSecs 60 `
            -ErrorAction Stop

        $stage = 'Validar resultado'
        Write-Host "Etapa: $stage"

        $scriptOutput = ([string]$result.ScriptOutput).Trim()

        if ($result.ExitCode -ne 0) {
            throw "El script remoto terminó con código $($result.ExitCode). $scriptOutput"
        }

        if ([string]::IsNullOrWhiteSpace($scriptOutput)) {
            throw 'El script remoto no devolvió ningún resultado.'
        }

        $parsedResult = $scriptOutput |
            ConvertFrom-Json -ErrorAction Stop

        if ($parsedResult.success -ne $true) {
            throw "La operación DNS no reportó éxito. $scriptOutput"
        }

        Write-Host 'Operación DNS completada correctamente.'
        Write-Host "Equipo: $($parsedResult.computerName)"
        Write-Host "Ejecutado como: $($parsedResult.executedAs)"
        Write-Host "Servidor DNS: $($parsedResult.dnsServer)"
        Write-Host "Estado: $($parsedResult.status)"
        Write-Host "Registro: $($parsedResult.fqdn)"
        Write-Host "IP: $($parsedResult.ipAddress)"

        return $scriptOutput
    }
    catch {
        throw "Falló la etapa '$stage': $($_.Exception.Message)"
    }
    finally {
        # Cerrar solamente la conexión abierta por esta acción.
        if ($null -ne $connection) {
            try {
                Disconnect-VIServer `
                    -Server $connection `
                    -Confirm:$false `
                    -ErrorAction Stop | Out-Null
            }
            catch {
                Write-Warning 'No fue posible cerrar la conexión a vCenter.'
            }
        }
    }
}
